
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090914">
<title>ROLPLEX AI</title>
<style>
*{box-sizing:border-box}
body{
  margin:0;background:#090914;color:#f5f3ff;
  font-family:Arial,sans-serif;min-height:100vh;
}
header{
  padding:24px 18px;text-align:center;
  border-bottom:1px solid #292044;
  background:linear-gradient(135deg,#151027,#090914);
}
.logo{
  font-size:34px;font-weight:900;letter-spacing:3px;
  color:#c084fc;text-shadow:0 0 18px #9333ea;
}
header p{color:#67e8f9;font-size:12px;letter-spacing:2px}
main{max-width:600px;margin:auto;padding:20px 16px}
h1{font-size:25px;margin-bottom:8px}
.sub{color:#a5a3bd;line-height:1.5}
.tabs{display:flex;gap:8px;margin:22px 0}
button{
  font-size:14px;font-weight:bold;cursor:pointer;
  border:1px solid #49356e;border-radius:12px;
  padding:13px 10px;background:#171329;color:#eee7ff;
}
.tabs button{flex:1}
button.active,.primary{
  background:#7928ca;border-color:#c084fc;
  box-shadow:0 0 14px #7928ca55;
}
.panel{
  background:#11101f;border:1px solid #393052;
  border-radius:18px;padding:18px;margin-bottom:14px;
}
.panel h2{margin-top:0;font-size:19px}
label{display:block;margin:12px 0 7px;color:#c4b5fd}
input,textarea{
  width:100%;padding:14px;border-radius:10px;
  border:1px solid #49356e;background:#090914;
  color:white;font:inherit;outline:none;
}
textarea{resize:vertical;min-height:90px}
.primary{width:100%;margin-top:12px}
.output{
  margin-top:14px;padding:12px;border-radius:10px;
  background:#1b1630;color:#ddd6fe;line-height:1.5;
  white-space:pre-wrap;overflow-wrap:anywhere;
}
.hidden{display:none}
footer{text-align:center;padding:20px;color:#77728e;font-size:12px}
</style>
</head>
<body>
<header>
  <div class="logo">ROLPLEX</div>
  <p>✦ TU UNIVERSO DE INTELIGENCIA ARTIFICIAL ✦</p>
</header>

<main>
  <h1>¿Qué hacemos hoy? ⚡</h1>
  <p class="sub">Tu espacio creativo. Elegí una herramienta para comenzar.</p>

  <div class="tabs">
    <button class="active" data-tab="chat">💬 Chat</button>
    <button data-tab="images">🎨 Imágenes</button>
    <button data-tab="voice">🎙️ Voz</button>
  </div>

  <section id="chat" class="panel">
    <h2>💜 Chat IA</h2>
    <p class="sub">Hablá con tu futuro asistente inteligente.</p>
    <label for="message">Tu mensaje</label>
    <textarea id="message" placeholder="Escribí algo..."></textarea>
    <button class="primary" id="send">Enviar mensaje ➜</button>
    <div id="reply" class="output hidden" aria-live="polite"></div>
  </section>

  <section id="images" class="panel hidden">
    <h2>🎨 Generador de imágenes</h2>
    <p class="sub">Describí la imagen que te gustaría crear.</p>
    <label for="prompt">Descripción de la imagen</label>
    <textarea id="prompt" placeholder="Un dragón cibernético con luces violetas..."></textarea>
    <button class="primary" id="create">Preparar descripción ✦</button>
    <div id="imageReply" class="output hidden"></div>
  </section>

  <section id="voice" class="panel hidden">
    <h2>🎙️ Modo voz</h2>
    <p class="sub">Probá la función de voz de tu navegador.</p>
    <label for="spoken">Texto para escuchar</label>
    <input id="spoken" placeholder="Hola, soy ROLPLEX">
    <button class="primary" id="speak">🔊 Escuchar</button>
    <div id="voiceReply" class="output hidden"></div>
  </section>
</main>

<footer>ROLPLEX AI · PROTOTIPO 1.0</footer>

<script>
const buttons = document.querySelectorAll("[data-tab]");
buttons.forEach(button => {
  button.addEventListener("click", () => {
    buttons.forEach(b => b.classList.remove("active"));
    button.classList.add("active");
    document.querySelectorAll("main section").forEach(s =>
      s.classList.toggle("hidden", s.id !== button.dataset.tab)
    );
  });
});

document.getElementById("send").onclick = () => {
  const message = document.getElementById("message").value.trim();
  const reply = document.getElementById("reply");
  if (!message) {
    alert("¡Escribí un mensaje primero!");
    return;
  }
  reply.classList.remove("hidden");
  reply.textContent = "¡Mensaje recibido! 💜\nEscribiste: " + message +
    "\n\nEsta es una versión de prueba. Para obtener respuestas inteligentes, conectaremos un servicio de IA en el siguiente paso.";
};

document.getElementById("create").onclick = () => {
  const prompt = document.getElementById("prompt").value.trim();
  const result = document.getElementById("imageReply");
  if (!prompt) {
    alert("¡Describí la imagen que querés crear!");
    return;
  }
  result.classList.remove("hidden");
  result.textContent = "Descripción preparada ✨\n" + prompt +
    "\n\nTodavía falta conectar el servicio que genera las imágenes.";
};

document.getElementById("speak").onclick = () => {
  const text = document.getElementById("spoken").value.trim();
  const result = document.getElementById("voiceReply");
  if (!text) {
    alert("¡Escribí algo para escuchar!");
    return;
  }
  result.classList.remove("hidden");
  if ("speechSynthesis" in window) {
    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = "es-AR";
    window.speechSynthesis.speak(utterance);
    result.textContent = "Reproduciendo voz 🔊";
  } else {
    result.textContent = "Tu navegador no admite esta función de voz.";
  }
};
</script>
</body>
</html>
